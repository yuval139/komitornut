rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function meRef() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function approved() { return signedIn() && exists(meRef()) && get(meRef()).data.status == 'approved'; }
    function isAdmin() { return approved() && get(meRef()).data.is_admin == true; }
    function level(section) { return get(meRef()).data.levels.get(section, 'none'); }
    function canRead(section) { return approved() && level(section) in ['read', 'write']; }
    function canWrite(section) { return approved() && level(section) == 'write'; }
    // each stored key belongs to exactly one section
    function keyOk(section, key) {
      return (section == 'staff' && key in ['staff', 'departments-and-closing'])
        || (section == 'rosters' && key in ['history', 'rule-weights', 'custom-rules', 'sheets-link'])
        || (section == 'closings' && key in ['bakanz-events', 'bakanz-auth'])
        || (section == 'published' && key in ['published-week'])
        || (section == 'duty' && key in ['duty-mech', 'duty-sgl', 'duty-off'])
        || (section == 'requests' && key is string && key.matches('req:.+'));
    }

    // one document per person: who they are, whether they are approved, and what they may do
    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // anyone signed in may ask to join (pending). Only the admin's own e-mail
      // can create an approved admin, and only for itself.
      allow create: if signedIn() && request.auth.uid == uid && (
        (request.resource.data.status == 'pending' && request.resource.data.is_admin == false
            && request.resource.data.person_id == null
            && request.resource.data.keys().hasOnly(['name', 'email', 'status', 'is_admin', 'person_id', 'levels', 'created_at']))
        || (request.auth.token.email == 'yuvally222@gmail.com'
            && request.auth.token.email_verified == true
            && request.resource.data.status == 'approved'
            && request.resource.data.is_admin == true));
      // admins change anything; a member may only choose who they are, once
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && resource.data.person_id == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['person_id']));
      allow delete: if isAdmin();
    }

    // names-only list (id + name) for the sign-up screen: any signed-in person reads it, only an admin writes it
    match /signup/{id} {
      allow get: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // one small note that every approved member updates after saving, so others know whether to look
    match /meta/{id} {
      allow get: if approved();
      allow create, update: if approved();
      allow delete: if false;
    }

    // the crew's data: one document per stored key, with its section named in the document
    match /docs/{docId} {
      allow get, list: if canRead(resource.data.section);
      allow create: if canWrite(request.resource.data.section)
        && keyOk(request.resource.data.section, request.resource.data.key)
        && docId == request.resource.data.section + '__' + request.resource.data.key;
      allow update: if canWrite(request.resource.data.section)
        && keyOk(request.resource.data.section, request.resource.data.key)
        && resource.data.section == request.resource.data.section
        && docId == request.resource.data.section + '__' + request.resource.data.key;
      allow delete: if false;
    }
    // רשימת כוננות: the list, its officers, and each person's own confirmation
    match /standby/{id} {
      function sbPerson() { return get(meRef()).data.get('person_id', null); }
      function sbOfficer() {
        return sbPerson() != null
          && exists(/databases/$(database)/documents/standby/config)
          && get(/databases/$(database)/documents/standby/config).data.get('officers', []).hasAny([sbPerson()]);
      }
      function sbManager() { return isAdmin() || sbOfficer(); }
      function sbHowOk(d) { return d.how is string && d.how.size() > 0 && d.how.size() <= 100; }
      allow get: if approved() && (id in ['config', 'current'] || sbManager()
        || resource == null || resource.data.get('person', null) == sbPerson());
      allow list: if approved() && sbManager();
      allow create, update: if approved() && (
        (id == 'config' && isAdmin())
        || (id == 'current' && sbManager())
        || (id.matches('c_.+') && (sbManager() || (
              sbPerson() != null && request.resource.data.person == sbPerson()
              && id == 'c_' + request.resource.data.list + '_' + sbPerson()
              && request.resource.data.keys().hasOnly(['kind', 'list', 'person', 'how', 'at', 'by'])
              && sbHowOk(request.resource.data))))
        || (id.matches('how_.+') && (sbManager() || (
              sbPerson() != null && request.resource.data.person == sbPerson()
              && id == 'how_' + sbPerson()
              && request.resource.data.keys().hasOnly(['kind', 'person', 'how', 'at'])
              && sbHowOk(request.resource.data)))));
      allow delete: if false;
    }
  }
}
